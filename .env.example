# LLM (LiteLLM-style model id used by CrewAI). Examples:
#   gpt-4o-mini            (needs OPENAI_API_KEY)
#   anthropic/claude-sonnet-4-5   (needs ANTHROPIC_API_KEY)
#   gemini/gemini-2.5-flash       (needs GEMINI_API_KEY)
MODEL=gpt-4o-mini
MODEL_TEMPERATURE=0
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Adverse media search
TAVILY_API_KEY=

# live = call Tavily and cache results; replay = cache only (reproducible eval)
VRS_SEARCH_MODE=live

CREWAI_DISABLE_TELEMETRY=true
OTEL_SDK_DISABLED=true
